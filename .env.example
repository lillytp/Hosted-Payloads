# Example environment file — NAMES ONLY, NO REAL VALUES.
# Copy to .env (which is git-ignored) on your OWN machine and fill it there,
# or better, use a real secret manager. NEVER paste real values into chat or
# commit them. See business/SECURITY.md.
#
# The agents do not need banking credentials — all money movement is executed
# by you. These references exist only for read-only integrations you may add
# later (e.g. a Stripe RESTRICTED read key to reconcile the ledger).

# Stripe restricted (read-only) key — optional, for reconciliation only.
STRIPE_RESTRICTED_KEY=

# Public-facing business email (not a secret, but keep config in one place).
BUSINESS_PUBLIC_EMAIL=

# Do NOT add: bank logins, full Stripe secret keys, EIN, passwords, 2FA seeds.
